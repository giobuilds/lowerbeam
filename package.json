{
  "name": "lowerbeam",
  "version": "0.11.0",
  "description": "Desktop control panel for llama.cpp: launch, tune, download and chat with local models",
  "main": "./out/main/index.js",
  "author": {
    "name": "Giovanni Dick",
    "email": "giova19@proton.me"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "npm run build && electron-builder",
    "test": "node tests/run.mjs",
    "test:all": "node tests/run.mjs --all",
    "release:suggest": "node scripts/release.mjs suggest",
    "release:prepare": "node scripts/release.mjs prepare",
    "release:notes": "node scripts/release.mjs notes",
    "audit:deps": "node scripts/audit.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/diff": "^7.0.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "diff": "^8.0.4",
    "dompurify": "^3.4.16",
    "electron-updater": "^6.8.9",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "desktopName": "lowerbeam.desktop",
  "productName": "Lowerbeam",
  "engines": {
    "node": ">=22.12.0"
  }
}
